# Copy to backend/.env (gitignored) or set keys in the app: Settings → AI.
# Keys are read only by the backend and are never sent to the browser.
ANTHROPIC_API_KEY=
# Google Gemini (AI Studio key): practice evaluations + speech-to-text when no OpenAI key.
GEMINI_API_KEY=
# Optional: enables OpenAI models and speech-to-text transcription of recordings.
OPENAI_API_KEY=
